// Multibranch Pipeline script path: deploy/ci-cd/Jenkinsfile (not the repo
// root -- set this explicitly in the Jenkins job config).
//
// Flow: checkout -> resolve env from branch -> mvn build+test -> docker
// build (bakes the branch's design-time.substvar in) -> push to the private
// registry -> SSH deploy to the remote Docker host -> smoke test.
//
// Registry: Docker Hub (proadityaupadhyay/order-service-demo, public repo) --
// no registry host prefix needed, `docker login`/`push` default to docker.io.
// Deploy target: `remote-docker-host`, a container on the same Jenkins
// docker-compose stack simulating a real remote Docker host over SSH (see
// ../../jenkins-cicd/remote-docker-host/). Point REMOTE_HOST at a real
// user@host later to switch to an actual remote box; nothing else changes.
//
// TODO before a real remote host: swap REMOTE_HOST, otherwise unchanged.

pipeline {
    agent any

    environment {
        IMAGE_NAME         = 'proadityaupadhyay/order-service-demo'
        REGISTRY_CRED      = 'registry-credentials'
        REMOTE_HOST        = 'deploy@remote-docker-host'
        REMOTE_SSH_CRED    = 'remote-docker-ssh-key'
        REMOTE_DEPLOY_DIR  = 'order-service-deploy'
        DEPLOY_PORT        = '8083'        // host port 8080 was already taken by something else
        // On a real remote host, the deployed container's published port is
        // reachable at that host's own "localhost". In this local simulation,
        // remote-docker-host shares the Jenkins host's actual Docker socket,
        // so the container it deploys is really a sibling published on the
        // physical Docker Desktop host, not on remote-docker-host's own
        // network namespace -- "host.docker.internal" is what reaches it
        // from inside remote-docker-host. Switch this back to 'localhost'
        // when pointing REMOTE_HOST at a real remote box.
        SMOKE_TEST_HOST    = 'host.docker.internal'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Resolve Environment') {
            steps {
                script {
                    // TODO: adjust to the real branching convention.
                    def envMap = [
                        'dev'   : 'dev',
                        'qa'    : 'qa',
                        'uat'   : 'uat',
                        'main'  : 'prod',
                        'master': 'prod',
                        'prod'  : 'prod'
                    ]
                    env.DEPLOY_ENV = envMap.containsKey(env.BRANCH_NAME) ? envMap[env.BRANCH_NAME] : 'dev'
                    env.IMAGE_TAG = "${env.DEPLOY_ENV}-${env.BUILD_NUMBER}"
                    echo "Branch '${env.BRANCH_NAME}' -> environment '${env.DEPLOY_ENV}' (image tag ${env.IMAGE_TAG})"
                }
            }
        }

        stage('Build & Test (Maven)') {
            steps {
                dir('app') {
                    // -P${DEPLOY_ENV} bakes app/OrderService.application/configuration/{env}.substvar
                    // into the OrderService.application jar. See its pom.xml profiles.
                    sh "mvn -B clean package -P${env.DEPLOY_ENV}"
                }
            }
            post {
                always {
                    junit testResults: 'app/**/target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                // Re-runs the Maven build inside the image for a clean,
                // reproducible artifact (tests already ran and were
                // reported in the previous stage, so skipped here).
                sh """
                    docker build \
                        -f app/OrderService.application/docker/Dockerfile \
                        --build-arg DESIGN_TIME_ENV=${env.DEPLOY_ENV} \
                        -t ${IMAGE_NAME}:${env.IMAGE_TAG} \
                        -t ${IMAGE_NAME}:${env.DEPLOY_ENV}-latest \
                        app
                """
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: env.REGISTRY_CRED, usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                    sh """
                        echo "\$REG_PASS" | docker login -u "\$REG_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${env.IMAGE_TAG}
                        docker push ${IMAGE_NAME}:${env.DEPLOY_ENV}-latest
                        docker logout
                    """
                }
            }
        }

        stage('Deploy') {
            steps {
                sshagent(credentials: [env.REMOTE_SSH_CRED]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_HOST} 'mkdir -p ${REMOTE_DEPLOY_DIR}'
                        rsync -az --delete -e 'ssh -o StrictHostKeyChecking=no' deploy/ ${REMOTE_HOST}:${REMOTE_DEPLOY_DIR}/
                        ssh -o StrictHostKeyChecking=no ${REMOTE_HOST} \
                            "IMAGE=${IMAGE_NAME}:${env.IMAGE_TAG} PORT=${DEPLOY_PORT} bash ${REMOTE_DEPLOY_DIR}/ci-cd/deploy/deploy-${env.DEPLOY_ENV}.sh"
                    """
                }
            }
        }

        stage('Smoke Test') {
            steps {
                sshagent(credentials: [env.REMOTE_SSH_CRED]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_HOST} \
                            "bash ${REMOTE_DEPLOY_DIR}/scripts/smoke-test.sh ${SMOKE_TEST_HOST} ${DEPLOY_PORT}"
                    """
                }
            }
        }
    }

    post {
        failure {
            echo "Pipeline failed for branch ${env.BRANCH_NAME} (env: ${env.DEPLOY_ENV ?: 'unresolved'})"
            // TODO: Slack/email notification
        }
    }
}
